{
  "name": "youtube-insight-dashboard",
  "version": "1.0.0",
  "description": "AI-powered YouTube video analysis dashboard with question answering, chapters, and quizzes",
  "private": true,
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "react-scripts": "5.0.1",
    "react-window": "^2.2.7"
  },
  "scripts": {
    "start": "set GENERATE_SOURCEMAP=false && react-scripts start",
